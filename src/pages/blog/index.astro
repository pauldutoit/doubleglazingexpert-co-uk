---
import BaseLayout from '../../layouts/BaseLayout.astro';
import siteConfig from '../../data/site.config.json';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const fmt = (d) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout
  title={`Window & double glazing guides | ${siteConfig.siteName}`}
  description="Plain-English guides on window costs, uPVC vs aluminium, misted units, choosing an installer and comparing double glazing quotes."
>
  <section class="hero">
    <div class="container">
      <div class="breadcrumb"><a href="/">Home</a> / Guides</div>
      <h1>Window &amp; double glazing guides</h1>
      <p class="lede">Costs, materials, repairs and how to compare quotes without the hard sell.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {posts.length === 0 && <p>No guides yet.</p>}
      <ul class="post-list">
        {posts.map((post) => (
          <li class="post-card">
            <p class="post-meta">
              <time datetime={post.data.publishDate.toISOString()}>{fmt(post.data.publishDate)}</time>
              {post.data.tags.length > 0 && <span> &middot; {post.data.tags.slice(0, 2).join(', ')}</span>}
            </p>
            <h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
            <p class="post-excerpt">{post.data.description}</p>
            <a href={`/blog/${post.id}/`} class="post-more">Read the guide &rarr;</a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
