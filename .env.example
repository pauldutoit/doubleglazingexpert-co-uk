# ─── Lead form ─── set these in Cloudflare Pages → Settings → Environment variables
#
# Phase 1 (now): Resend's shared sender, NO DNS / domain verification needed.
#   onboarding@resend.dev can only send TO the Resend account's own address,
#   so LEAD_TO_EMAIL must be that same address.
# Phase 2 (later): verify doubleglazingexpert.co.uk on Resend (SPF/DKIM), then
#   switch LEAD_FROM_EMAIL to leads@doubleglazingexpert.co.uk and LEAD_TO_EMAIL
#   to wherever leads should land.
RESEND_API_KEY=                        # Functions scope - resend.com -> API Keys
LEAD_FROM_EMAIL=onboarding@resend.dev  # Functions scope
LEAD_TO_EMAIL=webzqsd@gmail.com        # Functions scope - must equal the Resend account email in phase 1

# Optional. Turnstile anti-spam. If unset: the widget is hidden and the server
# skips the check (honeypot + per-IP rate limit still apply). Add later.
PUBLIC_TURNSTILE_SITE_KEY=             # build scope
TURNSTILE_SECRET_KEY=                  # Functions scope

# Used only by scripts/generate-city-content.mjs (never bundled, never deployed).
ANTHROPIC_API_KEY=
